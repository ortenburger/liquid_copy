# Liquid Copy local API (.env is optional — copy to .env and export, or pass inline)

# HTTP
PORT=8787
HOST=127.0.0.1

# Knowledge / RAG
KB_STORAGE_PATH=.kb-storage
RAG_FORCE_LOCAL_EMBED=1

# Firecrawl (company ingest + brand fill). Also sendable from the UI.
FIRECRAWL_API_KEY=

# Zernio (posts + analytics). Also sendable from the UI.
# Docs: https://docs.zernio.com/ — base must be https://zernio.com/api/v1
ZERNIO_API_KEY=
ZERNIO_API_BASE=https://zernio.com/api/v1
# Optional: pin a connected account from GET /v1/accounts
# ZERNIO_ACCOUNT_ID=
# ZERNIO_PLATFORM=linkedin

# LLM — Ollama by default when LLM_BASE_URL is set
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.1
# LLM_API_KEY=
